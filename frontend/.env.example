# CoreGuard UK Frontend - Railway Environment Variables
# Copy this file to .env and fill in your actual values

# Backend API URL (Required)
# Get this from your Railway backend service URL
NEXT_PUBLIC_API_URL=https://coreguarduk-prod.railway.internal

# Supabase Configuration (Required for authentication)
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Configuration (Optional)
NEXT_PUBLIC_APP_NAME=CoreGuard UK
NEXT_PUBLIC_APP_VERSION=1.0.0

# Environment (Optional)
# Railway sets this automatically, but you can override
NODE_ENV=production

# Feature Flags (Optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false
